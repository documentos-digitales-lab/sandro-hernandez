<!DOCTYPE html>
<html>
  <head>
    <title>InterviewProject</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand bg-white border-bottom py-2">
      <div class="container">
        <%= link_to "Invoice App",
            current_customer ? customer_path(current_customer) : root_path,
            class: "navbar-brand fw-semibold" %>
        <div class="d-flex align-items-center gap-2">
          <% if current_customer %>
            <span class="navbar-text">RFC: <%= current_customer.rfc %></span>
            <%= button_to "Log out", session_path, method: :delete,
                class: "btn btn-outline-secondary btn-sm" %>
          <% else %>
            <%= link_to "Log in", new_session_path, class: "btn btn-outline-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="alert alert-success mb-0 mt-3"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger mb-0 mt-3"><%= alert %></div>
      <% end %>
    </div>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.js"></script>
  </body>
</html>
