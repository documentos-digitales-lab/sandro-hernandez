<div class="container py-5" style="max-width: 860px;">
  <div class="d-flex align-items-end justify-content-between mb-4">
    <div>
      <h1 class="fw-bold mb-1">Invoices</h1>
      <p class="text-muted mb-0"><%= pluralize(@pagy.count, "invoice") %> for RFC <%= current_customer.rfc %></p>
    </div>
    <%= link_to "Create An Invoice", new_invoice_path, class: "btn btn-primary py-2 fw-semibold" %>
  </div>

  <% if @invoices.any? %>
    <table class="table align-middle">
      <thead>
        <tr class="text-uppercase text-muted small">
          <th>UUID</th>
          <th>Created</th>
          <th>Products</th>
          <th class="text-end">Total</th>
          <th class="text-end"></th>
        </tr>
      </thead>
      <tbody>
        <% @invoices.each do |invoice| %>
          <tr>
            <td class="font-monospace text-muted small"><%= invoice.uuid %></td>
            <td><%= l invoice.created_at, format: :long %></td>
            <td><%= pluralize(@products_count_by_invoice[invoice.id] || 0, "product") %></td>
            <td class="text-end fw-semibold"><%= number_to_currency(invoice.total) %></td>
            <td class="text-end"><%= link_to "View", invoice_path(invoice), class: "btn btn-outline-secondary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% else %>
    <div class="alert alert-secondary">No invoices yet.</div>
  <% end %>
</div>