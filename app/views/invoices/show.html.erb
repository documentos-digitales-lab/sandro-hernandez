<div class="container py-5" style="max-width: 860px;">
  <div class="mb-4">
    <h1 class="fw-bold mb-1">Invoice</h1>
    <p class="text-muted mb-0">Invoice #<%= @invoice.id %> · Customer #<%= @invoice.customer_id %></p>
  </div>

  <%= render "invoice_summary",
        items: @invoice.items,
        taxes: @taxes,
        additional_taxes: @additional_taxes %>
</div>