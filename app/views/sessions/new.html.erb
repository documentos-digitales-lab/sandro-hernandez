<div class="container py-5" style="max-width: 480px;">
  <div class="card">
    <div class="card-body">
      <h1 class="h4 fw-bold mb-1">Log in</h1>
      <p class="text-muted mb-4">Enter the RFC you registered with.</p>

      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= form_with(url: session_path, class: "d-flex flex-column gap-3") do |f| %>
        <div>
          <%= f.label :rfc, "RFC", class: "form-label fw-semibold" %>
          <%= f.text_field :rfc, class: "form-control", required: true, autocomplete: "off" %>
        </div>
        <%= f.submit "Sign in", class: "btn btn-primary w-100 py-2 fw-semibold" %>
      <% end %>

      <hr>
      <p class="text-muted mb-0">New here? <%= link_to "Create an account", new_customer_path %></p>
    </div>
  </div>
</div>